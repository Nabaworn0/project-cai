{
  "name": "computer-repair-shop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "tsx tools/validate-content.ts",
    "test": "playwright test",
    "check": "npm run typecheck && npm run validate && npm run test:unit && npm run build && npm run test",
    "test:unit": "tsx --test tools/*.test.ts",
    "pixelize": "tsx tools/pixelize.ts",
    "voice": "python tools/voice.py",
    "teach-frames": "tsx tools/teach-frames.ts",
    "video": "tsx tools/video.ts"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "phaser": "^4.2.1",
    "preact": "^11.0.1",
    "qrcode-generator": "^2.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
